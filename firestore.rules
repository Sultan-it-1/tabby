rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserDocument(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The first Firebase build stored every tool state inside users/{uid}.data.
    // A stale cached client can still run that build after a deploy.  It must
    // never be allowed to replace the legacy map with an empty local snapshot.
    // New clients read this map once and copy it to /data documents. The map
    // remains an immutable safety archive; clients must never remove it.
    function hasLegacyData(documentData) {
      return documentData.keys().hasAny(['data']);
    }

    function legacyDataIsProtected() {
      return (!hasLegacyData(resource.data) && !hasLegacyData(request.resource.data))
        || (hasLegacyData(resource.data)
          && hasLegacyData(request.resource.data)
          && request.resource.data.data == resource.data.data);
    }

    function hasValidProfileShape() {
      return request.resource.data.keys().hasOnly([
        'email',
        'displayName',
        'schemaVersion',
        'updatedAt',
        'migratedAt',
        'data'
      ]);
    }

    function hasValidDataShape() {
      return request.resource.data.keys().hasOnly([
          'key',
          'value',
          'deleted',
          'sensitive',
          'writerVersion',
          'deleteRequestId',
          'clientUpdatedAt',
          'updatedAt'
        ])
        && request.resource.data.key is string
        && request.resource.data.key.size() > 0
        && request.resource.data.key.size() <= 100
        && request.resource.data.value is string
        && request.resource.data.value.size() <= 900000
        && request.resource.data.deleted is bool
        && request.resource.data.sensitive is bool
        && request.resource.data.clientUpdatedAt is int
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.keys().hasAny(['writerVersion'])
          || request.resource.data.writerVersion is int)
        && (!request.resource.data.keys().hasAny(['deleteRequestId'])
          || (request.resource.data.deleteRequestId is string
            && request.resource.data.deleteRequestId.size() <= 100));
    }

    function hasAuthenticatedDeleteRequest() {
      return request.resource.data.keys().hasAll(['writerVersion', 'deleteRequestId'])
        && request.resource.data.writerVersion >= 3
        && request.resource.data.deleteRequestId is string
        && request.resource.data.deleteRequestId.size() > 0;
    }

    match /users/{userId} {
      allow read, delete: if ownsUserDocument(userId);
      // New profiles never create the deprecated `data` map. Existing legacy
      // maps are immutable safety archives, which blocks the old empty-
      // snapshot uploader from adding, replacing, or deleting them.
      allow create: if ownsUserDocument(userId)
        && hasValidProfileShape()
        && !hasLegacyData(request.resource.data);
      allow update: if ownsUserDocument(userId)
        && hasValidProfileShape()
        && legacyDataIsProtected();

      match /data/{keyId} {
        allow read: if ownsUserDocument(userId);
        allow delete: if false;
        // Cached pre-v3 clients may still upload ordinary values, but they can
        // no longer turn a browser-storage reset into cloud tombstones.
        allow create: if ownsUserDocument(userId)
          && hasValidDataShape()
          && (!request.resource.data.deleted || hasAuthenticatedDeleteRequest());
        allow update: if ownsUserDocument(userId)
          && hasValidDataShape()
          && (!request.resource.data.deleted
            || (hasAuthenticatedDeleteRequest()
              && (!resource.data.keys().hasAny(['deleteRequestId'])
                || request.resource.data.deleteRequestId != resource.data.deleteRequestId)));
      }

      // Immutable recovery snapshots are written before any migration merge.
      // Each user can only read and write their own recovery data.
      match /recovery/{recoveryId}/{document=**} {
        allow read, write: if ownsUserDocument(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
