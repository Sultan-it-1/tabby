{
  "manifest_version": 3,
  "name": "Royal Family [DEV Mode]",
  "version": "2.0.30",
  "description": "نسخة المطور لتجربة التعديلات من الخادم المحلي http://127.0.0.1:5500/",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://127.0.0.1/*",
    "*://localhost/*",
    "*://*.sultanops.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "افتح اللوحة الجانبية (DEV Mode)"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://127.0.0.1/*",
        "*://localhost/*",
        "*://*.sultanops.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
