{
  "manifest_version": 3,
  "name": "Royal Family - Fast Toolkit",
  "version": "2.0.25",
  "description": "لوحة الأدوات السريعة تفتح كشريط جانبي بجوار موقع العمل مباشرة",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.sultanops.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "افتح اللوحة الجانبية Fast Toolkit"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.sultanops.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
